# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Variables for the RadUI deploy templates. Copy this file to deploy.local/vars.env (git-ignored),
# change the values for your host, then render with
#
#   python3 tools/render-deploy.py --vars deploy.local/vars.env --out deploy.local/rendered
#
# Format: KEY=VALUE, one per line. No quotes are needed, no shell expansion happens and a value
# cannot refer to another variable. Allowed value characters: letters, digits, space and
# . _ / : , % + = ~ -  (anything else, an empty value or an unset variable makes the render fail).
# Every variable is used by at least one template; every placeholder @@NAME@@ in a template
# must be defined here.

# ---- Public name ---------------------------------------------------------------------------

# Host name clients use to reach Radicale and RadUI (nginx server_name, backend allowed_hosts and
# allowed_origins https://<name>).
SERVER_NAME=example.org

# URL path the web app is served under, no trailing slash. The admin API lives below it
# (<UI_PATH>/api/, which is the backend's base_path).
UI_PATH=/ui

# Directory with the deployed web app (the contents of src/, with config.json next to index.html).
UI_DIR=/var/www/radui-ui

# ---- Accounts, groups and the Radicale side ------------------------------------------------

# System user and group that run the admin backend (created by deploy/install-backend.sh).
RADUI_USER=radui
RADUI_GROUP=radui

# Group Radicale runs as. It reads the generated users and rights files through this group; the
# managed directory is owned by RADUI_USER with this group, mode 2750.
RADICALE_GROUP=radicale

# systemd unit of Radicale (fail2ban reads its journal).
RADICALE_UNIT=radicale.service

# Python interpreter that can import Radicale. The backend runs the pre-write validation with it
# (python -I), so candidate files are checked by the Radicale version that is really installed.
# For a virtualenv install use <venv>/bin/python.
RADICALE_PYTHON=/usr/bin/python3

# Radicale's [server] max_connections. Radicale's default is 8. Each anonymous failed or
# unauthenticated request holds one slot for about a second (auth delay), so a small value limits
# parallel clients; raise it before ever considering cache_logins. See docs/ADMIN.md.
RADICALE_MAX_CONNECTIONS=32

# ---- Directories ---------------------------------------------------------------------------

# Backend configuration (config.toml, root-owned, group-readable by RADUI_GROUP). Every parent of
# MANAGED_DIR must be searchable by the Radicale user.
CONFIG_DIR=/etc/radui

# Generated users, rights and rights.lkg (written by the backend, read by Radicale).
MANAGED_DIR=/etc/radui/managed

# Private backend state: model.json, generations, lock file (mode 0700).
STATE_DIR=/var/lib/radui

# Root-owned, read-only code: <INSTALL_DIR>/backend (package and launchers).
INSTALL_DIR=/opt/radui

# Directory Radicale imports radui_rights.py from (root-owned, not writable by Radicale).
PLUGIN_DIR=/opt/radui/plugin

# Where the radui-admin-cli symlink goes.
BIN_DIR=/usr/local/bin

# Rollback copies made by install-backend.sh (<thing>.before-radui-<YYYYMMDD>, mode 600).
ARCHIVE_DIR=/var/backups/radui

# Directory the nginx snippets are installed to; the vhost includes them from here.
NGINX_SNIPPETS_DIR=/etc/nginx/snippets

# ---- Backend and Radicale ports ------------------------------------------------------------

# Where the backend listens (loopback only; must match nginx proxy_pass). host:port.
BACKEND_LISTEN=127.0.0.1:5233

# Where Radicale listens (nginx proxy_pass, backend radicale_url). host:port.
RADICALE_UPSTREAM=127.0.0.1:5232

# ---- nginx ---------------------------------------------------------------------------------

# Rate for the admin API per client address (limit_req_zone rate). Format <n>r/s or <n>r/m.
API_RATE=120r/m

# Burst allowance on top of API_RATE for one client address (limit_req burst, nodelay).
API_BURST=30

# client_max_body_size for the Radicale location (calendar and contact uploads). The admin API
# is fixed at 16k, which is the backend's own limit.
RADICALE_MAX_BODY=50M

# Strict-Transport-Security max-age in seconds. includeSubDomains and preload are left out on
# purpose: they affect other sites of the domain; add them yourself if you know you want them.
HSTS_MAX_AGE=31536000

# Certificate and key used by the example vhost.
TLS_CERT=/etc/ssl/example.org/fullchain.pem
TLS_KEY=/etc/ssl/example.org/privkey.pem

# ---- fail2ban ------------------------------------------------------------------------------

# Addresses that are never banned (space separated, CIDR allowed). Add your own static address
# here if you have one.
F2B_IGNOREIP=127.0.0.1/8 ::1

# A client address is banned after F2B_MAXRETRY failed logins within F2B_FINDTIME, for F2B_BANTIME.
F2B_MAXRETRY=10
F2B_FINDTIME=10m
F2B_BANTIME=1h

# fail2ban action used for the ban (nftables-multiport handles IPv4 and IPv6).
F2B_BANACTION=nftables-multiport

# Ports blocked for a banned address.
F2B_PORT=http,https
