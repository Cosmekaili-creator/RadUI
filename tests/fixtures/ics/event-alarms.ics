BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Example Corp//Calendar 1.0//EN
BEGIN:VEVENT
UID:alarms@example.org
DTSTAMP:20260101T000000Z
DTSTART:20260501T090000Z
DTEND:20260501T100000Z
SUMMARY:Event with several alarms
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT15M
DESCRIPTION:Reminder
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER;RELATED=END:PT5M
DESCRIPTION:After the end
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER;VALUE=DATE-TIME:20260501T080000Z
DESCRIPTION:Absolute
END:VALARM
BEGIN:VALARM
ACTION:AUDIO
TRIGGER:-PT30M
ATTACH;FMTTYPE=audio/basic:https://example.org/sounds/ding
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT1H
REPEAT:2
DURATION:PT10M
DESCRIPTION:Repeating
END:VALARM
END:VEVENT
END:VCALENDAR
